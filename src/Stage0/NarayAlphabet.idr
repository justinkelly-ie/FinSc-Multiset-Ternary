module Stage0.NarayAlphabet

import Stage0.BoxInt
import Stage1.ScaleTransform
import public Stage1.TypeTheory.Smoothness
import public Stage0.Singleton.Bit
import Stage0.OnSeq.FusedStream
import Data.Fuel
import Data.Vect

%default total

||| Binary bit F2 = {0, 1}
public export
data Bit2 = Bit2Zero | Bit2One

public export
Eq Bit2 where
  Bit2Zero == Bit2Zero = True
  Bit2One  == Bit2One  = True
  _        == _        = False

public export
Show Bit2 where
  show Bit2Zero = "0"
  show Bit2One  = "1"

||| Convert Bit2 to Math.Singleton.Bit
public export
bit2ToBit : Bit2 -> Bit
bit2ToBit Bit2Zero = Zero
bit2ToBit Bit2One  = One

||| Convert Math.Singleton.Bit to Bit2
public export
bitToBit2 : Bit -> Bit2
bitToBit2 b = if isOne b then Bit2One else Bit2Zero

||| Balanced ternary bit F3 = {-1, 0, 1}
public export
data Bit3 = Bit3MinusOne | Bit3Zero | Bit3PlusOne

public export
Eq Bit3 where
  Bit3MinusOne == Bit3MinusOne = True
  Bit3Zero     == Bit3Zero     = True
  Bit3PlusOne  == Bit3PlusOne  = True
  _            == _            = False

public export
Show Bit3 where
  show Bit3MinusOne = "-1"
  show Bit3Zero     = " 0"
  show Bit3PlusOne  = "+1"

||| Convert Bit3 to integer scalar
public export
bit3ToInt : Bit3 -> Integer
bit3ToInt Bit3MinusOne = -1
bit3ToInt Bit3Zero     = 0
bit3ToInt Bit3PlusOne  = 1

||| Dependent finite field/alphabet generated by index n:
||| n = 2 => Binary Field F2 = {0, 1}
||| n = 3 => Balanced Ternary Field F3 = {-1, 0, 1}
public export
data NarayAlphabet : (n : Nat) -> Type where
  Naray2 : Bit2 -> NarayAlphabet 2
  Naray3 : Bit3 -> NarayAlphabet 3

public export
Eq (NarayAlphabet n) where
  (Naray2 b1) == (Naray2 b2) = b1 == b2
  (Naray3 t1) == (Naray3 t2) = t1 == t2

public export
Show (NarayAlphabet n) where
  show (Naray2 b) = show b
  show (Naray3 t) = show t

||| Field addition over F2 (XOR) and F3 (balanced mod 3).
public export
addNaray : NarayAlphabet n -> NarayAlphabet n -> NarayAlphabet n
addNaray (Naray2 Bit2Zero) (Naray2 b2)       = Naray2 b2
addNaray (Naray2 b1)       (Naray2 Bit2Zero) = Naray2 b1
addNaray (Naray2 Bit2One)  (Naray2 Bit2One)  = Naray2 Bit2Zero
addNaray (Naray3 Bit3Zero) (Naray3 t2)       = Naray3 t2
addNaray (Naray3 t1)       (Naray3 Bit3Zero) = Naray3 t1
addNaray (Naray3 Bit3PlusOne) (Naray3 Bit3PlusOne)  = Naray3 Bit3MinusOne -- 1 + 1 = 2 = -1 mod 3
addNaray (Naray3 Bit3MinusOne) (Naray3 Bit3MinusOne) = Naray3 Bit3PlusOne  -- -1 + -1 = -2 = 1 mod 3
addNaray (Naray3 Bit3PlusOne) (Naray3 Bit3MinusOne) = Naray3 Bit3Zero
addNaray (Naray3 Bit3MinusOne) (Naray3 Bit3PlusOne) = Naray3 Bit3Zero

||| Field multiplication over F2 (AND) and F3 (balanced mod 3).
public export
mulNaray : NarayAlphabet n -> NarayAlphabet n -> NarayAlphabet n
mulNaray (Naray2 Bit2Zero) _                 = Naray2 Bit2Zero
mulNaray (Naray2 _)       (Naray2 Bit2Zero) = Naray2 Bit2Zero
mulNaray (Naray2 Bit2One)  (Naray2 Bit2One)  = Naray2 Bit2One
mulNaray (Naray3 Bit3Zero) _                 = Naray3 Bit3Zero
mulNaray (Naray3 _)       (Naray3 Bit3Zero) = Naray3 Bit3Zero
mulNaray (Naray3 Bit3PlusOne) (Naray3 t2)    = Naray3 t2
mulNaray (Naray3 t1) (Naray3 Bit3PlusOne)    = Naray3 t1
mulNaray (Naray3 Bit3MinusOne) (Naray3 Bit3MinusOne) = Naray3 Bit3PlusOne

||| Multiplicative inverse in F2 and F3.
public export
invNaray : NarayAlphabet n -> Maybe (NarayAlphabet n)
invNaray (Naray2 Bit2Zero) = Nothing
invNaray (Naray2 Bit2One)  = Just (Naray2 Bit2One)
invNaray (Naray3 Bit3Zero)     = Nothing
invNaray (Naray3 Bit3PlusOne)  = Just (Naray3 Bit3PlusOne)
invNaray (Naray3 Bit3MinusOne) = Just (Naray3 Bit3MinusOne)

||| Returns the size of the multiplicative unit group F_n^\times.
public export
unitGroupSize : (n : Nat) -> Nat
unitGroupSize 2 = 1 -- F2^\times = {1} (C1)
unitGroupSize 3 = 2 -- F3^\times = {-1, 1} (C2)
unitGroupSize _ = 0

||| Converts a NarayAlphabet element to an integer scalar.
public export
narayToInt : NarayAlphabet n -> Integer
narayToInt (Naray2 Bit2Zero) = 0
narayToInt (Naray2 Bit2One)  = 1
narayToInt (Naray3 t)        = bit3ToInt t

public export
ScaleTransform Bit3 Integer where
  scaleTransform = bit3ToInt

public export
InvertibleScaleTransform Bit3 Integer where
  invertScaleTransform n =
    if n <= -1 then Bit3MinusOne
    else if n == 0 then Bit3Zero
    else Bit3PlusOne

------------------------------------------------------------------------
-- STREAMING HORNER TERNARY EXPANSION
------------------------------------------------------------------------

||| Evaluates a stream of balanced ternary trits into an integer value via fused Horner expansion (radix = 3) with model-indexed GohFuel.
public export
streamHornerTernaryFuelModel : GohFuel cap -> FusedStream Bit3 -> BoxInt
streamHornerTernaryFuelModel fuel strm =
  foldStreamFuelModel fuel
    (\acc, t =>
      let tInt = intToBoxInt (bit3ToInt t)
      in addBox (mulBox acc (intToBoxInt 3)) tInt)
    (intToBoxInt 0)
    strm

||| Evaluates a stream of balanced ternary trits into an integer value via fused Horner expansion using canonical Goh fuel derived from capacity.
public export
streamHornerTernaryGoh : (capacity : Nat) -> FusedStream Bit3 -> BoxInt
streamHornerTernaryGoh cap = streamHornerTernaryFuelModel (gohFuelForCapacity cap)

||| Evaluates a stream of balanced ternary trits into an integer value via fused Horner expansion (radix = 3).
public export
streamHornerTernary : Fuel -> FusedStream Bit3 -> BoxInt
streamHornerTernary f strm =
  foldStreamFuel f
    (\acc, t =>
      let tInt = intToBoxInt (bit3ToInt t)
      in addBox (mulBox acc (intToBoxInt 3)) tInt)
    (intToBoxInt 0)
    strm

||| Audits that 3 ternary trits (+1, 0, 0)_3 evaluate to 9, and (+1, 0, 0, 0)_3 evaluates to 27 (Elliptic manifest space).
public export
auditStreamHornerTernaryProof : Bool
auditStreamHornerTernaryProof =
  let tritStream3 = stream [Bit3PlusOne, Bit3Zero, Bit3Zero]
      tritStream4 = stream [Bit3PlusOne, Bit3Zero, Bit3Zero, Bit3Zero]
      v9  = streamHornerTernaryFuelModel (gohFuelForCapacity 3) tritStream3
      v27 = streamHornerTernaryFuelModel (gohFuelForCapacity 4) tritStream4
  in unwrapBox v9 == 9 && unwrapBox v27 == 27

------------------------------------------------------------------------
-- ELLIPTIC 27 CANONICAL TERNARY EMBEDDING (RULE 03)
------------------------------------------------------------------------

||| Evaluates a 3-trit register into an exact BoxInt scalar in [-13, 13] (Elliptic 27 capacity):
||| val = 9*t2 + 3*t1 + t0.
public export
vect3TritsToBoxInt : Vect 3 Bit3 -> BoxInt
vect3TritsToBoxInt [t2, t1, t0] =
  let v2 = mulBox (intToBoxInt (bit3ToInt t2)) (intToBoxInt 9)
      v1 = mulBox (intToBoxInt (bit3ToInt t1)) (intToBoxInt 3)
      v0 = intToBoxInt (bit3ToInt t0)
  in addBox v2 (addBox v1 v0)

||| Helper to convert an integer scalar to a balanced trit:
public export
intToBit3Rem : Integer -> (Bit3, Integer)
intToBit3Rem n =
  let m = ((n + 1) `mod` 3) - 1
      q = (n - m) `div` 3
      b = if m <= -1 then Bit3MinusOne
          else if m == 0 then Bit3Zero
          else Bit3PlusOne
  in (b, q)

||| Decodes an integer scalar in [-13, 13] into a 3-trit register in balanced ternary:
public export
boxIntToVect3Trits : BoxInt -> Vect 3 Bit3
boxIntToVect3Trits b =
  let n = unwrapBox b
      (t0, q0) = intToBit3Rem n
      (t1, q1) = intToBit3Rem q0
      (t2, _)  = intToBit3Rem q1
  in [t2, t1, t0]

||| Canonical Elliptic 27 Manifest Canvas Ternary Embedding:
||| Maps 3-trit registers (3^3 = 27) directly into the Elliptic lattice state capacity.
public export
DepScaleTransform Stage1.TypeTheory.Smoothness.dimElliptic27 Stage1.TypeTheory.Smoothness.dimElliptic27 (Vect 3 Bit3) BoxInt where
  depScaleTransform = vect3TritsToBoxInt

public export
InvertibleDepScaleTransform Stage1.TypeTheory.Smoothness.dimElliptic27 Stage1.TypeTheory.Smoothness.dimElliptic27 (Vect 3 Bit3) BoxInt where
  invertDepScaleTransform = boxIntToVect3Trits

||| Audits the roundtrip bijection for the 27 ternary states:
public export
auditTernaryDepScaleTransformProof : Bool
auditTernaryDepScaleTransformProof =
  let tMax : Vect 3 Bit3 = [Bit3PlusOne, Bit3PlusOne, Bit3PlusOne]
      tMin : Vect 3 Bit3 = [Bit3MinusOne, Bit3MinusOne, Bit3MinusOne]
      tZero : Vect 3 Bit3 = [Bit3Zero, Bit3Zero, Bit3Zero]
      bMax = depScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} tMax
      bMin = depScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} tMin
      bZero = depScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} tZero
      rtMax = invertDepScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} bMax
      rtMin = invertDepScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} bMin
      rtZero = invertDepScaleTransform {sourceDim = Stage1.TypeTheory.Smoothness.dimElliptic27} {targetDim = Stage1.TypeTheory.Smoothness.dimElliptic27} bZero
  in unwrapBox bMax == 13 && unwrapBox bMin == -13 && unwrapBox bZero == 0
     && rtMax == tMax && rtMin == tMin && rtZero == tZero

public export
0 verifyTernaryDepScaleTransform : Stage0.NarayAlphabet.auditTernaryDepScaleTransformProof = True
verifyTernaryDepScaleTransform = Refl

