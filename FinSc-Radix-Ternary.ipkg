package FinSc-Radix-Ternary
version = 0.2.0
authors = "Justin Kelly"
brief   = "Layer 4 Balanced Ternary Field F3, 27-State Elliptic Lattice & Narayana Dyck Sifting"

depends = FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Radix-Binary, base, linear
sourcedir = "src"

modules = Stage0.NarayAlphabet,
          Stage0.NarayState,
          Stage0.NarayElab,
          Stage1.TernaryLogic,
          Stage1.AlgebraOfBoole,
          Stage1.NarayanaPolynomial
